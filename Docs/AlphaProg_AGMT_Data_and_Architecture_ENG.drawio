        <mxCell id="fusion" value="" style="rounded=0;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fontColor=#18212B;align=center;verticalAlign=middle;spacing=0;overflow=fill;strokeWidth=1.2;fillColor=#FBF2F3;strokeColor=#B17884;shadow=0;glass=0;gradientColor=none;collapsible=0;container=1;recursiveResize=0;connectable=1;" vertex="1" parent="1">
