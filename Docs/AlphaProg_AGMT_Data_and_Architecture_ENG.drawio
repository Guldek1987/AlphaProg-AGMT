        </mxCell>
        <mxCell id="cues" value="&lt;div style=&quot;font-family:'Times New Roman',Tinos,'Liberation Serif',serif;font-size:18px;text-align:center;line-height:1.22;&quot;&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;&lt;b&gt;Reliability cues&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;\(\boldsymbol{\kappa}\in\mathbb{R}^{8}\): history, task level,&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;forecast disagreement,&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;forecast ambiguity&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fontColor=#18212B;align=center;verticalAlign=middle;spacing=0;overflow=fill;strokeWidth=1.2;fillColor=#FFFFFF;strokeColor=#B17884;shadow=0;glass=0;gradientColor=none;collapsible=0;" vertex="1" parent="fusion">
          <mxGeometry x="12" y="40" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="weight" value="&lt;div style=&quot;font-family:'Times New Roman',Tinos,'Liberation Serif',serif;font-size:18px;text-align:center;line-height:1.22;&quot;&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;&lt;b&gt;Gate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;Impute + scale: \(\boldsymbol{\kappa}\rightarrow\tilde{\boldsymbol{\kappa}}\)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;\(\alpha=\sigma(\boldsymbol{\beta}_{\nu}^{\top}[1;\tilde{\boldsymbol{\kappa}}])\)&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;\(\nu\): known or new task&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fontColor=#18212B;align=center;verticalAlign=middle;spacing=0;overflow=fill;strokeWidth=1.2;fillColor=#FFFFFF;strokeColor=#B17884;shadow=0;glass=0;gradientColor=none;collapsible=0;" vertex="1" parent="fusion">
          <mxGeometry x="272" y="40" width="266" height="96" as="geometry" />
        </mxCell>
        <mxCell id="mixture" value="&lt;div style=&quot;font-family:'Times New Roman',Tinos,'Liberation Serif',serif;font-size:18px;text-align:center;line-height:1.22;&quot;&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;\((\hat p,\hat h)=(p_B,h_B)+\alpha\,[(p_G,h_G)-(p_B,h_B)]\)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fontColor=#18212B;align=center;verticalAlign=middle;spacing=0;overflow=fill;strokeWidth=1.2;fillColor=#FFFFFF;strokeColor=#B17884;shadow=0;glass=0;gradientColor=none;collapsible=0;" vertex="1" parent="fusion">
          <mxGeometry x="12" y="152" width="526" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a_out" value="&lt;div style=&quot;font-family:'Times New Roman',Tinos,'Liberation Serif',serif;font-size:18px;text-align:center;line-height:1.22;&quot;&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;\(\hat p\): probability of a correct first run; \(\hat h\): conditional hazard of success in later runs.&lt;/div&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;\(q\): new task; \(\ell\): history length; \(\alpha\): weight of the expert; fitted parameters are fixed at inference.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=18;fontColor=#18212B;align=center;verticalAlign=middle;spacing=0;overflow=fill;strokeWidth=1.2;fillColor=none;strokeColor=none;shadow=0;glass=0;gradientColor=none;collapsible=0;fontStyle=2;" vertex="1" parent="1">
