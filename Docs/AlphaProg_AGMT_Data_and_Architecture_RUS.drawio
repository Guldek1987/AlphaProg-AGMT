        <mxCell id="fusion_title" value="&lt;div style=&quot;font-family:'Times New Roman',Tinos,'Liberation Serif',serif;font-size:20px;text-align:center;line-height:1.22;&quot;&gt;&lt;div style=&quot;white-space:nowrap;line-height:1.22;&quot;&gt;3. Слияние с гейтом надёжности&lt;/div&gt;&lt;/div&gt;" style="rounded=0;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;fontColor=#18212B;align=center;verticalAlign=middle;spacing=0;overflow=fill;strokeWidth=1.2;fillColor=none;strokeColor=none;shadow=0;glass=0;gradientColor=none;collapsible=0;fontStyle=1;" vertex="1" parent="fusion">
